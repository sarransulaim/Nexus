# ═══════════════════════════════════════════════════════════════════════════
# Nexus Command backend — environment template.
# Copy to .env for local dev, or set these on your host (Railway/Render/Docker).
# NEVER commit a real .env — only this example belongs in git.
# ═══════════════════════════════════════════════════════════════════════════

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nexus_core
# 64+ random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 16+ chars — guards the one-time first-manager /auth/setup
SETUP_SECRET=
# Stable secret for encrypting OAuth/MCP tokens at rest (survives JWT rotation)
NEXUS_TOKEN_KEY=
# Anthropic API key — the orchestrator brain
CLAUDE_API_KEY=

# ── AI providers ────────────────────────────────────────────────────────────
# Gemini: Gmail/Calendar reasoning + hosted RAG embeddings on cloud deploys
GEMINI_API_KEY=
# RAG embeddings: auto (prefer local Ollama, fall back to Gemini) | ollama | gemini
EMBED_PROVIDER=auto
# Local Ollama (free tier: briefings, summaries, preference learning, embeddings)
OLLAMA_HOST=http://localhost:11434

# ── URLs / CORS ─────────────────────────────────────────────────────────────
# Public URL of THIS API (used in links shown to users)
BACKEND_URL=http://localhost:8000
# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Google Workspace OAuth (Gmail/Calendar/Meet) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# ── Outward-action approval gate ────────────────────────────────────────────
# 1 (default) = AI email/invite sends require human approval. 0 = demos only.
NEXUS_REQUIRE_APPROVAL=1

# ── Slack (Socket Mode bot) ─────────────────────────────────────────────────
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── Twilio / WhatsApp (optional) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_BASE=

# ── Telegram (stub) / LiveKit (optional) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
