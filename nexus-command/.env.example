# ── Nexus landing — environment variables (set these in Vercel → Project → Settings → Environment Variables) ──

# Resend API key (free at https://resend.com → API Keys). Powers both demo emails and the waitlist.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Your inbox — where demo requests are emailed so you can send a meeting link.
NOTIFY_EMAIL=you@example.com

# Optional sender. The default (onboarding@resend.dev) works WITHOUT verifying a domain,
# but Resend's test sender only delivers to your own account email. Verify a domain in
# Resend and set e.g. "Nexus <hello@yourdomain.com>" to email anyone.
MAIL_FROM=Nexus <onboarding@resend.dev>

# Optional — create an Audience in Resend (Audiences → +), paste its ID here.
# Waitlist signups are added here (no email sent). Without it, signups are only logged.
RESEND_AUDIENCE_ID=
